# /opt/sisyphus/sites/ohmyondas.levm.eu/server/.env.local on the VPS (mode 600). Never commit.
# Device tokens: one per device, comma-separated. Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKENS=<token-device-1>
# Claude (server-side only, never on the device)
ANTHROPIC_API_KEY=<anthropic-api-key>
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_FALLBACKS=1
PLAN_EVERY_BARS=16
PLAN_TIMEOUT_S=6
ATTACH_SPECTROGRAM=0
# Tagger (model baked into the image at build time)
TAGGER=auto
YAMNET_SPEECH_DISCARD=0.3
MIC_CLIPS_REQUIRE_MODEL=1
# Place context
PLACE_ENABLED=1
OVERPASS_URL=https://overpass-api.de/api/interpreter
CONTACT_URL=https://ohmyondas.levm.eu
# Journal (on the /data volume)
JOURNAL_ENABLED=1
JOURNAL_RETENTION_DAYS=30
LOG_LEVEL=INFO
