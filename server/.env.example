# Copy to .env (git-ignored) and fill in. Never commit real values.
# Comma-separated device tokens; each device sends "Authorization: Bearer <token>".
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKENS=replace-me
# Claude. Without a key the server uses the rule-based planner only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_FALLBACKS=1
# Planning
PLAN_EVERY_BARS=16
PLAN_TIMEOUT_S=6
PLAN_MIN_INTERVAL_S=4
FEATURE_CHANGE_THRESHOLD=0.35
ATTACH_SPECTROGRAM=0
# Clips
CLIP_INTERVAL_S=60
CLIP_SECONDS=6
CLIP_REQUEST_TIMEOUT_S=30
RATE_CONNECT_BACKLOG=4000
TAGGER=auto
# Place context
PLACE_ENABLED=1
OVERPASS_URL=https://overpass-api.de/api/interpreter
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
CONTACT_URL=https://ohmyondas.levm.eu
# Cost estimate (USD per million tokens; check current pricing)
PRICE_INPUT_PER_MTOK=2.0
PRICE_OUTPUT_PER_MTOK=10.0
# Network / logging
BIND_HOST=127.0.0.1
PORT=8765
SESSION_IDLE_S=1800
# Per-connection message rate limit (token bucket)
RATE_MSGS_PER_S=200
RATE_BURST=400
LOG_LEVEL=INFO
# Tagger: auto = YAMNet when models/yamnet.tflite exists (tools/fetch_model.py), else numpy fallback
YAMNET_MODEL=
YAMNET_SPEECH_DISCARD=0.3
# Without the speech model, mic clips are not requested and are discarded unseen
MIC_CLIPS_REQUIRE_MODEL=1
# Thinking: adaptive (default) or between_tools (no up-front thinking, lower latency)
ANTHROPIC_THINKING=adaptive
# Walk journal (JSONL per session; no audio, GPS rounded to ~100 m)
JOURNAL_ENABLED=1
JOURNAL_DIR=data/journal
JOURNAL_RETENTION_DAYS=30
